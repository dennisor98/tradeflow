# Copy to .env on the server and fill in real values.

# --- Database ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=tradeflow

# --- Admin console ---
# Read at application boot. The admin account is created in the database if it
# does not exist; if it does exist, its role, active flag and password are
# re-synced from these values. Change ADMIN_PASSWORD here and restart to
# rotate the password.
# ADMIN_PASSWORD must be at least 12 characters or no admin is created.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Signs admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production — boot fails without it.
ADMIN_SESSION_SECRET=

# --- Trading ---
# Length of a trading session in minutes. Defaults to 10 if unset.
NEXT_PUBLIC_TRADING_SESSION_MINUTES=10

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- M-Pesa ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_PARTY_B=
MPESA_ENV=production
NEXT_PUBLIC_APP_URL=
